{
  "name": "tracking-api",
  "version": "1.5.0",
  "description": "",
  "scripts": {
    "build": "rm -rf build && tsc",
    "ts": "rm -rf build && tsc -w",
    "start-dev": "nodemon build/server.js",
    "start": "node build/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "push-tag": "git push --tags",
    "tag-major": "npm version major && npm run push-tag",
    "tag-minor": "npm version minor && npm run push-tag",
    "tag-fix": "npm version patch && npm run push-tag",
    "cid": "rm -rf node_modules && rm package-lock.json && npm i",
    "run-docker": "docker build -t tracking-api . --no-cache && docker run --publish 8080:8080 --restart=no --runtime=runc -d tracking-api",
    "eslint": "npx eslint",
    "prettier": "prettier . --write",
    "lint": "npm run eslint && npm run prettier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostboard/api.git"
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "David Burgos",
    "email": "support+github@growblog.io"
  },
  "homepage": "https://github.com/ghostboard/api#readme",
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@newrelic/fastify": "github:newrelic-experimental/newrelic-javascript-fastify",
    "bullmq": "^6.7.4",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.8",
    "fastify-no-icon": "^7.0.0",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "isbot": "^5.2.3",
    "knex": "^3.3.0",
    "moment": "^2.31.0",
    "newrelic": "^11.23.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.1",
    "turbo-geoip-country": "^26.10.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "form-data": "^4.0.6",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
